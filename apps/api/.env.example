# Copy this file to .env and fill in real values for local development.
# .env itself is gitignored and never committed.

# Connection string for a local PostgreSQL instance.
# Not used by the test suite (Testcontainers provisions its own ephemeral Postgres
# and overrides this at runtime) — only needed for `pnpm start:dev`.
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Port the NestJS HTTP server listens on.
PORT=3001

# Secret used to sign/verify JWT access tokens. Use a long random value in any
# real environment; the test suite sets its own secret and does not read this.
JWT_SECRET="local-dev-secret-change-me"
